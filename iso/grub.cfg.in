# T-Rex Bites boot menu (computers that start in UEFI mode)
if [ x$feature_default_font_path = xy ] ; then
    font=unicode
else
    font=$prefix/font.pf2
fi
if loadfont $font ; then
    set gfxmode=800x600
    set gfxpayload=keep
    insmod efi_gop
    insmod efi_uga
    insmod video_bochs
    insmod video_cirrus
    insmod gfxterm
    terminal_output gfxterm
fi
set menu_color_normal=white/black
set menu_color_highlight=black/yellow
set timeout=-1

submenu 'Instalar T-Rex Bites' {
    set menu_color_highlight=white/red
    menuentry 'No, volver' {
        configfile /boot/grub/grub.cfg
    }
    menuentry 'ATENCION: Si, BORRAR TODO el disco e instalar T-Rex Bites' {
        linux /install.amd/vmlinuz @KERNEL_ARGS@
        initrd /install.amd/initrd.gz
    }
}
submenu 'Instalar al lado de otro Linux (Fedora, Ubuntu...)' {
    set menu_color_highlight=black/yellow
    menuentry 'No, volver' {
        configfile /boot/grub/grub.cfg
    }
    menuentry 'Si, instalar T-Rex Bites SOLO en el espacio libre (tu Linux no se toca)' {
        linux /install.amd/vmlinuz @KERNEL_ARGS_LINUX@
        initrd /install.amd/initrd.gz
    }
}
submenu 'Instalar al lado de Windows (usa el espacio libre)' {
    set menu_color_highlight=black/yellow
    menuentry 'No, volver' {
        configfile /boot/grub/grub.cfg
    }
    menuentry 'Si, instalar T-Rex Bites SOLO en el espacio libre del disco' {
        linux /install.amd/vmlinuz @KERNEL_ARGS_LIBRE@
        initrd /install.amd/initrd.gz
    }
}
menuentry 'Salir (arrancar normalmente desde el disco)' {
    exit
}
