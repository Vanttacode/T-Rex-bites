[Unit]
Description=T-Rex Bites - panel web (http://trexbites.local)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tv
Group=tv
WorkingDirectory=/opt/trexbites/panel
Environment=TREXBITES_FS42_DIR=/opt/trexbites/fieldstation42
Environment=TREXBITES_STATE=/var/lib/trexbites/panel.json
# big uploads are buffered on the media disk, not in /tmp (RAM on Debian 13)
Environment=TMPDIR=/srv/trexbites/.uploads
ExecStart=/opt/trexbites/panel/env/bin/uvicorn trexbites_panel.app:app --host 0.0.0.0 --port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
