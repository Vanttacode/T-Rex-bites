# WiFi setup on the TV screen itself (keyboard or mouse), shown on the first
# start while the box has no network. It also explains the phone method when
# the WiFi card can create the "T-Rex Bites Config" network.
# Starting it stops the TV and the bedtime screen.
[Unit]
Description=T-Rex Bites - pantalla de configuración de WiFi
Conflicts=fs42.service trexbites-bedtime.service
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/trexbites/panel/trexbites_panel/setup_screen.py
Restart=always
RestartSec=3
