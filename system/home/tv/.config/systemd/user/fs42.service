# Named fs42.service so FieldStation42's own web console can restart it.
[Unit]
Description=T-Rex Bites - reproductor de tele (FieldStation42)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/opt/trexbites/fieldstation42
# channel change effect chosen in the panel (long = static, short, none)
Environment=TREX_TRANSITION=long
EnvironmentFile=-/var/lib/trexbites/player.env
ExecStart=/opt/trexbites/fieldstation42/env/bin/python3 field_player.py --transition ${TREX_TRANSITION}
Restart=always
RestartSec=5

[Install]
WantedBy=trexbites-x11.target
